# --- OS cruft ---------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# --- Editors ----------------------------------------------------------------
*.swp
*.swo
*~
.idea/
.vscode/

# --- Ansible ----------------------------------------------------------------
# Written next to the playbook on a partial failure; regenerated every run.
*.retry

# Fact cache / log destinations, if ever enabled in ansible.cfg.
ansible.log
facts.d/

# Vault password files. Never commit these — the name is a convention, not a
# guarantee, so this is a backstop rather than the reason it is safe.
.vault_pass
.vault_pass.txt
vault-password*

# Local inventory and variable overrides. inventory.ini itself IS tracked; these
# are the per-machine variants that should stay on the machine.
inventory.local
inventory.*.local
host_vars/
group_vars/*.local.yml

# Component selections written by `bootstrap.sh -m`. These describe one machine's
# choices, not the project's defaults — those live in group_vars/all.yml.
*.local.yml

# Collections/roles pulled in by ansible-galaxy. The playbook deliberately uses
# ansible.builtin only, so these should stay empty — ignored in case that ever
# changes.
collections/
roles/galaxy/

# --- Secrets ----------------------------------------------------------------
*.pem
*.key
id_rsa*
id_ed25519*
.env

# Added by /project-bootstrap — workspace standard patterns.
.AppleDouble
.LSOverride
.claude/settings.local.json
.env.*
!.env.example
!.env.*.example
*.p12
credentials.json
client_secret*.json
service-account*.json
token.json
secrets.yml
secrets.yaml
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
wheels/
*.egg
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
~$*.xlsx
~$*.docx
~$*.pptx
*.log
tmp/
.tmp/

